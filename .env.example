# Copy to .env for local development. Do not commit populated secrets.

# Model provider. Vikram has no default provider or model.
# Run `vikram configure` (alias: `vikram setup`) for local config, or set
# these for this environment. Valid providers: ollama, ollama-cloud,
# anthropic, gemini, openai, digitalocean, openai-compatible.
# VIKRAM_MODEL_PROVIDER=ollama

# Model identifier. Provider-dependent:
#   ollama / ollama-cloud -> an Ollama tag, e.g. llama3.2 or gpt-oss:120b
#   anthropic             -> e.g. claude-sonnet-5
#   gemini                -> e.g. gemini-2.5-flash
#   openai                -> e.g. gpt-5-mini
#   digitalocean          -> e.g. llama3.3-70b-instruct
# Leave unset to use the selected provider's model from config.toml.
# VIKRAM_MODEL=

# Ollama local development.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Ollama Cloud (https://ollama.com).
# OLLAMA_API_KEY=
# VIKRAM_OLLAMA_CLOUD_BASE_URL=https://ollama.com

# Anthropic Claude.
# ANTHROPIC_API_KEY=

# Google Gemini (GOOGLE_API_KEY also accepted).
# GEMINI_API_KEY=

# OpenAI.
# OPENAI_API_KEY=
# VIKRAM_OPENAI_BASE_URL=https://api.openai.com/v1

# DigitalOcean serverless inference.
# DIGITALOCEAN_ACCESS_TOKEN=
# VIKRAM_DIGITALOCEAN_BASE_URL=https://inference.do-ai.run/v1

# Generic OpenAI-compatible endpoint (e.g. Sarvam AI); also the backcompat
# path — OPENAI_API_KEY / DIGITALOCEAN_ACCESS_TOKEN / SARVAM_API_KEY feed it.
# VIKRAM_OPENAI_COMPAT_API_KEY=
# VIKRAM_OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1

# Agent selection and local state.
# VIKRAM_AGENT=vikram
# VIKRAM_SPEC_ROOT=/abs/path/to/spec
# VIKRAM_DB_PATH=.vikram/vikram.sqlite3
# DBOS_SYSTEM_DATABASE_URL=sqlite:///.vikram/dbos.sqlite3
# VIKRAM_PUBLIC_BASE_URL=https://example.ngrok-free.app

# Logging and tracing.
# VIKRAM_LOG_LEVEL=INFO
# VIKRAM_OBSERVABILITY_ENABLED=false
# VIKRAM_OBSERVABILITY_SERVICE_NAME=vikram
# VIKRAM_OTLP_ENDPOINT=http://localhost:4318
# VIKRAM_OBSERVABILITY_CAPTURE_MESSAGE_CONTENT=false
# VIKRAM_OBSERVABILITY_DISABLE_METRICS=false
# VIKRAM_OBSERVABILITY_DISABLED_INSTRUMENTORS=mistral
# VIKRAM_CONTEXT_WINDOW_TOKENS=256000
# VIKRAM_CONTEXT_WARNING_RATIO=0.85

# Web search tool. Required if an active agent spec lists "web_search".
# PARALLEL_API_KEY=

# Telegram interface. These env names are referenced by spec/telegram.toml.
# VIKRAM_TELEGRAM_BOT_TOKEN=
# VIKRAM_TELEGRAM_WEBHOOK_SECRET=
# VIKRAM_TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890
# VIKRAM_TELEGRAM_BOT_USERNAME=VikramBot
# VIKRAM_TELEGRAM_API_BASE_URL=https://api.telegram.org

# MCP servers. Agents reference secrets as ${ENV_VAR} in [[mcp_servers]] (see
# docs/mcp_and_skills.md). Define whatever an enabled server's spec references,
# for example:
# GITHUB_TOKEN=
# DOCS_MCP_TOKEN=
